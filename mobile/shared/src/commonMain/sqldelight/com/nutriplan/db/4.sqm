-- Version 4 -> 5: the queue of edits and removals of meals made while offline (DPL-407). A new
-- table only; the other caches and the queue of added meals are untouched.

CREATE TABLE pending_change (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    plan_id TEXT NOT NULL,
    meal_id TEXT NOT NULL,
    meal_type TEXT NOT NULL,
    kind TEXT NOT NULL,
    servings REAL,
    day_index INTEGER,
    satisfaction_level INTEGER,
    attempts INTEGER NOT NULL DEFAULT 0,
    failure TEXT
);
