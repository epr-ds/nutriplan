-- Offline cache of meal plans (mirrors data.model.MealPlanSummary / MealPlan / PlanMeal, which follow
-- contracts/dietary.openapi.yaml). It is a read cache of what the server sent: the list only gives
-- summaries, so the detail columns stay empty until a plan has been opened (has_detail = 0).

CREATE TABLE meal_plan (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    start_date TEXT NOT NULL,
    end_date TEXT NOT NULL,
    status TEXT NOT NULL,
    daily_calorie_target INTEGER,           -- only known once the full plan was fetched
    nutritional_summary TEXT,               -- JSON of NutritionalSummary, same condition
    has_detail INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0
);

CREATE TABLE plan_meal (
    id TEXT NOT NULL PRIMARY KEY,
    plan_id TEXT NOT NULL REFERENCES meal_plan(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,              -- index in the server's meal list, to keep its order
    meal_type TEXT NOT NULL,
    servings REAL NOT NULL,
    day_index INTEGER,
    satisfaction_level INTEGER,
    recipe TEXT,                            -- JSON of PlanMealRecipe, null on plan reads
    nutritional_info TEXT                   -- JSON of NutritionalInfo
);

CREATE INDEX plan_meal_plan_id ON plan_meal(plan_id);

selectAllPlans:
SELECT id, name, start_date, end_date, status FROM meal_plan ORDER BY start_date DESC, id;

selectDetailedPlanById:
SELECT * FROM meal_plan WHERE id = ? AND has_detail = 1;

selectPlanIds:
SELECT id FROM meal_plan;

upsertSummary:
INSERT INTO meal_plan(id, name, start_date, end_date, status)
VALUES (?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    name = excluded.name,
    start_date = excluded.start_date,
    end_date = excluded.end_date,
    status = excluded.status;

upsertDetail:
INSERT OR REPLACE INTO meal_plan(
    id, name, start_date, end_date, status, daily_calorie_target, nutritional_summary, has_detail
) VALUES (?, ?, ?, ?, ?, ?, ?, 1);

invalidateDetail:
UPDATE meal_plan SET daily_calorie_target = NULL, nutritional_summary = NULL, has_detail = 0 WHERE id = ?;

deletePlan:
DELETE FROM meal_plan WHERE id = ?;

selectMealsForPlan:
SELECT * FROM plan_meal WHERE plan_id = ? ORDER BY position;

insertMeal:
INSERT OR REPLACE INTO plan_meal(
    id, plan_id, position, meal_type, servings, day_index, satisfaction_level, recipe, nutritional_info
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteMealsForPlan:
DELETE FROM plan_meal WHERE plan_id = ?;

deleteAllMeals:
DELETE FROM plan_meal;

deleteAllPlans:
DELETE FROM meal_plan;
