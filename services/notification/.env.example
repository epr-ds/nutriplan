# Notification service configuration (NOTIFICATION_-prefixed env vars override these).
NOTIFICATION_ENVIRONMENT=development

# Datastore + message bus. Leave the bus blank and it falls back to the Redis URL.
NOTIFICATION_REDIS_URL=redis://localhost:6379/0
# The feed is a rolling window: entries age out after 30 days, capped at 500 per user.
NOTIFICATION_FEED_TTL_SECONDS=2592000
NOTIFICATION_FEED_MAX_ENTRIES=500
# A handled event is remembered for 24h so a redelivery is a no-op; the 60s claim taken
# before the notification is written bounds how long a crashed worker can suppress one.
NOTIFICATION_DEDUPE_TTL_SECONDS=86400
NOTIFICATION_DEDUPE_CLAIM_SECONDS=60
# NOTIFICATION_EVENT_BUS_URL=
NOTIFICATION_ORDER_EVENT_STREAM=commerce.order-events
NOTIFICATION_CONSUMER_GROUP=notification

# Push providers. Injected from the vault in stage/prod; blank is fine for local work.
# NOTIFICATION_FCM_PROJECT_ID=
# NOTIFICATION_FCM_CREDENTIALS_JSON=
# NOTIFICATION_APNS_TEAM_ID=
# NOTIFICATION_APNS_KEY_ID=
# NOTIFICATION_APNS_PRIVATE_KEY=

# Points the store and probe suites at a live Redis without changing the service's own config.
# NOTIFICATION_TEST_REDIS_URL=redis://localhost:6379/0
